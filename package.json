    "body-parser": "^1.20.6",
    "http-proxy-middleware": "^2.0.10",
    "form-data": "^4.0.6",
    "@babel/core": "^7.29.6",
    "ws": "^8.21.0",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1",
    "@tootallnate/once": "^2.0.1",
